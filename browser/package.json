{
  "name": "browser",
  "version": "0.0.1",
  "description": "MinIO Browser",
  "scripts": {
    "test": "jest",
    "dev": "NODE_ENV=dev webpack serve --devtool eval-cheap-module-source-map --progress --hot",
    "build": "NODE_ENV=dev node build.js",
    "release": "NODE_ENV=production node build.js",
    "format": "prettier --write \"app/**/*.js\""
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "./app/js/jest/setup.js"
    ],
    "testEnvironmentOptions": {
      "url": "https://localhost:8080"
    },
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/app/js/jest/__mocks__/fileMock.js",
      "\\.(css|scss)$": "identity-obj-proxy"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/minio/minio"
  },
  "author": "MinIO Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/minio/minio/issues"
  },
  "homepage": "https://github.com/minio/minio",
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "async": "^3.2.6",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.8",
    "glob-all": "^3.3.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "less": "^4.9.1",
    "less-loader": "^13.1.0",
    "prettier": "^3.10.1",
    "purgecss-webpack-plugin": "^9.1.0",
    "redux-mock-store": "^1.5.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "bootstrap": "^3.4.1",
    "classnames": "^2.5.1",
    "core-js": "^3.51.0",
    "history": "^4.10.1",
    "humanize": "0.0.9",
    "jwt-decode": "^2.2.0",
    "local-storage-fallback": "^5.0.0",
    "material-design-iconic-font": "^2.2.0",
    "mime-types": "^3.0.2",
    "moment": "^2.31.0",
    "path-browserify": "^1.0.1",
    "react": "^16.14.0",
    "react-bootstrap": "^0.32.4",
    "react-copy-to-clipboard": "^5.1.0",
    "react-custom-scrollbars": "^4.2.1",
    "react-dom": "^16.14.0",
    "react-dropzone": "^11.7.1",
    "react-infinite-scroller": "^1.2.6",
    "react-onclickout": "^2.0.8",
    "react-qr-code": "^2.2.0",
    "react-redux": "^5.1.2",
    "react-router-dom": "^5.2.0",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "regenerator-runtime": "^0.14.1",
    "reselect": "^4.1.8",
    "superagent": "^10.4.2",
    "superagent-es6-promise": "^1.0.0",
    "url": "^0.11.4"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12",
    "test-exclude": "^8.0.0",
    "glob@>=9.0.0 <14.0.2": "^14.0.6",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  }
}
